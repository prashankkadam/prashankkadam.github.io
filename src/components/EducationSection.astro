---
import { education } from "../data/education";
---

<section id="education" class="container-readable py-16">
  <h2 class="section-title">Education</h2>
  <ol class="space-y-8">
    {
      education.map((e) => (
        <li>
          <h3 class="font-serif text-lg font-semibold mb-1">{e.school}</h3>
          <p class="text-sm font-medium text-[var(--color-text-muted)] mb-1">{e.degree}</p>
          {e.detail && <p class="text-[var(--color-text-muted)] leading-relaxed mb-1">{e.detail}</p>}
          {e.notes && <p class="font-mono text-xs text-[var(--color-text-subtle)]">{e.notes}</p>}
        </li>
      ))
    }
  </ol>
</section>
