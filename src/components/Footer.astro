---
import { profile } from "../data/profile";
const year = new Date().getFullYear();
---

<footer class="container-readable py-12 border-t border-[var(--color-border)] mt-12">
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <p class="font-mono text-xs text-[var(--color-text-subtle)]">
      &copy; {year} {profile.name}. Built with Astro &amp; Tailwind.
    </p>
    <div class="flex gap-5 text-sm">
      <a class="accent-link" href={profile.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      <a class="accent-link" href={profile.links.github} target="_blank" rel="noopener">GitHub</a>
      <a class="accent-link" href={profile.links.cv} target="_blank" rel="noopener">CV</a>
    </div>
  </div>
</footer>
