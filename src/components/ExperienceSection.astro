---
import { experiences } from "../data/experience";
---

<section id="experience" class="container-readable py-16">
  <h2 class="section-title">Experience</h2>
  <ol class="relative border-l border-[var(--color-border)] pl-6 space-y-10">
    {
      experiences.map((e) => (
        <li class="relative">
          <span class="absolute -left-[29px] top-2 w-2.5 h-2.5 rounded-full bg-[var(--color-accent)] ring-4 ring-[var(--color-bg)]" />
          <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-1 mb-2">
            <h3 class="font-serif text-lg font-semibold leading-snug">
              {e.role}
              <span class="text-[var(--color-text-muted)] font-normal"> · {e.org}</span>
            </h3>
            <span class="font-mono text-xs text-[var(--color-text-subtle)]">
              {e.start} to {e.end}
            </span>
          </div>
          <p class="text-[var(--color-text-muted)] leading-relaxed">{e.description}</p>
        </li>
      ))
    }
  </ol>
</section>
